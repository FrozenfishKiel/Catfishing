+from pathlib import Path
+import re, hashlib, json
+
+ROOT = Path(__file__).parent
+SRC = ROOT/'材料/钓鱼规则-整合稿.md'
+source = SRC.read_text(encoding='utf-8-sig')
+sections = {}
+for m in re.finditer(r'(?ms)^### (\d+\.\d+) ([^\n]+)\n(.*?)(?=^## |^### |\Z)', source):
+    body = m[3].strip()
+    blocks = re.split(r'\n\s*\n', body)
+    cursor=m.start(3); block_lines=[]
+    for block in blocks:
+        pos=source.index(block,cursor); block_lines.append(source[:pos].count('\n')+1); cursor=pos+len(block)
+    sections[m[1]] = {'title':m[2], 'blocks':blocks, 'line':source[:m.start()].count('\n')+1,'block_lines':block_lines}
+
+MAIN='钓鱼规则-主文.md'; MULTI='多人钓鱼-附篇.md'; PACK='62迁移包.md'; MAP='迁移对照表.md'
+docs={MAIN:[],MULTI:[],PACK:[]}
+routes={}; anchors={}; guides=[]; gaps=[]
+def add(file,text): docs[file].append(text.strip())
+def head(file,level,title,anchor,guide=None):
+    add(file,f'<a id="{anchor}"></a>\n\n'+('#'*level)+' '+title)
+    anchors[anchor]=file
+    if guide:
+        add(file,guide); guides.append((file,anchor,guide))
+def link(file,anchor,label): return f'[{label}]({file}#{anchor})'
+def route(sec,i,file,anchor,note='规则搬移；仅清理过程标记及更新引用'):
+    routes.setdefault((sec,i),[]).append((file,anchor,note))
+def b(sec,i): return sections[sec]['blocks'][i]
