+from pathlib import Path
+import re, hashlib, json
+
+ROOT = Path(__file__).parent
+SRC = ROOT/'材料/钓鱼规则-整合稿.md'
+source = SRC.read_text(encoding='utf-8-sig')
+sections = {}
+for m in re.finditer(r'(?ms)^### (\d+\.\d+) ([^\n]+)\n(.*?)(?=^## |^### |\Z)', source):
+    body = m[3].strip()
+    blocks = re.split(r'\n\s*\n', body)
+    sections[m[1]] = {'title':m[2], 'blocks':blocks, 'line':source[:m.start()].count('\n')+1}
+
+MAIN='钓鱼规则-主文.md'; MULTI='多人钓鱼-附篇.md'; PACK='62迁移包.md'; MAP='迁移对照表.md'
+docs={MAIN:[],MULTI:[],PACK:[]}
+routes={}; anchors={}; guides=[]; gaps=[]
+def add(file,text): docs[file].append(text.strip())
+def head(file,level,title,anchor,guide=None):
+    add(file,f'<a id="{anchor}"></a>\n\n'+('#'*level)+' '+title)
+    anchors[anchor]=file
+    if guide:
+        add(file,guide); guides.append((file,anchor,guide))
+def link(file,anchor,label): return f'[{label}]({file}#{anchor})'
+def route(sec,i,file,anchor,note='规则搬移；仅清理过程标记及更新引用'):
+    routes.setdefault((sec,i),[]).append((file,anchor,note))
+def b(sec,i): return sections[sec]['blocks'][i]
+def before(s,t): return s.split(t)[0]
+def between(s,a,z): return s.split(a,1)[1].split(z,1)[0]
+
+# 显式旧节引用统一改成稳定机制锚点；裸写 9.3 仍指源文档。
+ref={
+'2.1':('nest','窝点归属'),'2.3':('timer','独立计时'),'2.4':('draw','抽鱼与扣减'),
+'2.5':('decay','游走衰减'),'2.9':('gather','聚鱼时刻'),'2.10':('visibility','世界可见性'),
+'3.4':('bait','鱼饵与道具闸门'),'4.1':('strike','提竿响应'),'4.2':('resources','资源字段'),
+'4.3':('strength','强度检查'),'4.4':('cost','搏斗消耗'),'4.5':('feedback','信息反馈'),
+'4.6':('behavior','鱼行为'),'4.7':('abandon','主动放弃'),'5.1':('netcatch','可抄资格'),
+'5.2':('mouth','挥网与叼鱼态'),'5.3':('belly','翻肚拖岸'),'5.4':('order','服务器判序'),
+'5.5':('geometry','收鱼几何'),'7.1':('feedback','操作反馈'),'8.2':('move','合力移动'),
+'8.3':('move-cost','移动消耗与恢复'),'8.4':('move-feedback','移动反馈'),
+'9.1':('assist','辅助入退'),'9.2':('team-force','力量组成'),'9.4':('position','位置落水'),
+'9.5':('capture','捕获事件')}
+
+def clean(text,file):
+    # 原缺口逐字存放附录；正文只留下缺口前的规则。
+    if '⚠️' in text and not text.startswith('|'):
+        text=text.split('⚠️',1)[0].strip()
+    text=text.replace('**','')
+    text=re.sub(r'已裁（[^）]*09-07[^）]*）：?', '', text)
+    text=re.sub(r'（(?:2026-)?09-0[67][^）]*(?:裁决|拍|修订|改值|改|重拍)[^）]*）','',text)
+    text=re.sub(r'（09-07 N\d+）','',text)
+    text=text.replace('（N2 后演出与数据一致）','').replace('（09-07 N8）','')
+    text=text.replace('（09-07 N4：碾压瞬间恰是竿受力最大时刻，烂竿先断、装备门槛不被绕过）','')
+    text=text.replace('（09-07 N9）','')
+    # 仅替换有明确引用语境的节号，避免误改参数 1.5 等。
+    for old,(a,label) in ref.items():
+        target= MULTI if a in ('move','move-cost','move-feedback','assist','team-force') else MAIN
+        if file==MAIN and target==MULTI: continue
+        dest=f'#{a}' if target==file else f'{target}#{a}'
+        text=re.sub(r'(?<=见 )'+re.escape(old)+r'(?!\d)',f'[{label}]({dest})',text)
+        text=re.sub(r'(?<=按 )'+re.escape(old)+r'(?!\d)',f'[{label}]({dest})',text)
+        text=re.sub(r'(?<=复用 )'+re.escape(old)+r'(?!\d)',f'[{label}]({dest})',text)
+        text=re.sub(r'(?<=（)'+re.escape(old)+r'(?!\d)',f'[{label}]({dest})',text)
+    # 所有含数值的规则段、表格行补统一快照标记；不改变原数值。
+    lines=[]
+    in_code=False
+    for line in text.splitlines():
+        if line.startswith('```'): in_code=not in_code
+        visible=re.sub(r'\]\([^)]*\)',']',line)
+        if re.search(r'\d',visible) and '（快照，参数页为准）' not in line and not line.startswith('```') and not in_code:
+            if line.startswith('|') and line.endswith('|'):
+                line=line[:-1].rstrip()+'（快照，参数页为准） |'
+            else: line+='（快照，参数页为准）'
+        lines.append(line)
+    return '\n'.join(lines).strip()
+
+def emit(file,anchor,sec,inds,transform=None):
+    for i in inds:
+        text=b(sec,i)
+        if transform: text=transform(text,i)
+        add(file,clean(text,file))
+        route(sec,i,file,anchor,'按句拆分、统一字段／引用；原段全文保留在来源快照' if transform else '规则搬移；清理标记、更新引用、补快照标注')
+
+# 每个正文警示独立编号；组标题连带原列表保留，列表成员另列映射。
+for sec,d in sections.items():
+    for i,text in enumerate(d['blocks']):
+        if '⚠️' not in text: continue
+        if text.startswith('⚠️') and text.endswith('：') and i+1<len(d['blocks']):
+            raw=text+'\n\n'+d['blocks'][i+1]
+        elif text.startswith('|'):
+            for row in text.splitlines():
+                if '⚠️' in row:
+                    gaps.append((sec,i,row))
+            continue
+        else:
+            raw=text[text.index('⚠️'):]
+        gaps.append((sec,i,raw))
+gap_ids={}
+for n,(sec,i,raw) in enumerate(gaps,1): gap_ids.setdefault((sec,i),[]).append(f'gap-{n:02}')
+
+add(MAIN,'# 钓鱼规则\n\n适用于单人及多人共同使用的基础机制\n\n属主：钱成澔。状态：重构交付稿，待 Claude 审核、李前臻终审。\n\n'+link(MULTI,'scope','多人扩展入口')+'。多人可以叠加投料、合力拉竿、换人、抢收和举鱼展示。\n\n数值均为（快照，参数页为准）；已建专表以参数页挂号的专表为准，未建表的看参数页。建议值与验算输入不升级为正式配置。缺口原文集中于文末附录，责任人与未定状态保留。')
+head(MAIN,2,'1. 一竿流程与准备','prepare','猫带着装备来到水边准备钓鱼。')
+add(MAIN,'备装 → 可选打窝 → 抛竿 → 等待／试探 → 真咬／提竿 → 搏斗 → 收鱼／失败。')
+emit(MAIN,'prepare','2.7',[1],lambda t,i: '岸边只能切换已经带出的物品；'+t.split('岸边只能切换已经带出的物品；')[1])
+emit(MAIN,'prepare','2.7',[2],lambda t,i:'抄网与鱼护均非必带。准备由各玩家独立进行。')
+emit(MAIN,'prepare','3.1',[2],lambda t,i:before(t,'**站位不设合法区**'))
+add(MAIN,'开始前读取[道具与角色输入](#input-role)。叼鱼限制见[叼鱼态](#mouth)，操作封闭边界见[鱼饵与主动道具](#bait)。')
+
+head(MAIN,2,'2. 打窝、等待与抽鱼','nest-flow')
+head(MAIN,3,'2.1 窝点、投放与补窝','nest','一把窝料往这片水里添一批鱼。')
+emit(MAIN,'nest','1.1',[1,2])
+emit(MAIN,'nest','2.1',[1,2,3],lambda t,i:t.replace('原“浮漂最近圆心”即该规则特例，扩大到投料由此裁决授权。',''))
+emit(MAIN,'nest','2.2',[1,2])
+emit(MAIN,'nest','2.6',[1])
+head(MAIN,3,'2.2 每漂独立计时','timer','窝里的鱼越多，咬钩等得越短。')
+emit(MAIN,'timer','2.3',[1,2,3,4,5,6])
+head(MAIN,3,'2.3 抽鱼与扣减事务','draw','抽中的鱼当场离开窝点存量。')
+emit(MAIN,'draw','2.4',[1,2,3,4,5,6])
+add(MAIN,'时间戳完全并列的席位序约定见[服务器判序](#order)。鱼候选输入见[鱼候选与实例](#input-fish)，空候选和零权重保持未定。')
+head(MAIN,3,'2.4 游走衰减','decay','窝里的鱼会随时间逐批游走。')
+emit(MAIN,'decay','2.5',[1,3,4,5,6])
+head(MAIN,3,'2.5 聚鱼时刻','gather','均衡投料带来短时的咬钩加速。')
+emit(MAIN,'gather','2.9',[1,2,3,4],lambda t,i:t.replace('保留均衡投料触发短时聚鱼加速的意图。',''))
+for j in [0,3]:
+    add(MAIN,clean(b('2.9',6).splitlines()[j].removeprefix('- '),MAIN))
+route('2.9',6,MAIN,'gather','第 1、4 项已裁规则内收；其余项逐字保留于集中缺口')
+head(MAIN,3,'2.6 特殊窝料','special-bait')
+emit(MAIN,'special-bait','2.10',[2])
+head(MAIN,3,'2.7 渔网与死水','cast-net','一张渔网从窝里一次捞出一批鱼。')
+emit(MAIN,'cast-net','2.11',[1],lambda t,i:re.sub(r'随身限 1 张，每队每局限购 1—2 张；','',t))
+emit(MAIN,'cast-net','2.11',[3],lambda t,i:t.replace('——渔网是批量提款机，不是印钞机',''))
+
+head(MAIN,2,'3. 抛竿与提竿','casting')
+head(MAIN,3,'3.1 抛竿与浮漂落点','cast','猫朝选中的水面甩出浮漂。')
+emit(MAIN,'cast','3.1',[1])
+emit(MAIN,'cast','3.1',[2],lambda t,i:'站位不设合法区'+t.split('**站位不设合法区**')[1].split('不采用 42')[0])
+emit(MAIN,'cast','3.2',[1,3])
+head(MAIN,3,'3.2 等待与切饵','waiting')
+emit(MAIN,'waiting','3.3',[1,2])
+head(MAIN,3,'3.3 鱼饵与主动道具闸门','bait')
+emit(MAIN,'bait','3.4',[1,2],lambda t,i:re.sub(r'携带 8 份对应 8 次咬钩机会（快照，参数页为准），用完回营地补给。','',t))
+head(MAIN,3,'3.4 响应窗口与完美提竿','strike','及时提竿能削弱这条鱼的力量和体力。')
+emit(MAIN,'strike','4.1',[1,2,3,4])
+
+head(MAIN,2,'4. 搏斗与退出','battle')
+head(MAIN,3,'4.1 资源与有效力量','resources')
+emit(MAIN,'resources','4.2',[1],lambda t,i:t.replace('9.3 新增的','').replace('，新模型的接线未完成','；状态机接线仍待完成').replace('，待接进源文档 9.3 的状态机',''))
+add(MAIN,'`F_total` 表示本次对抗的有效总力量；无辅助时取持竿猫当前力量。`K_pos` 表示参与者消耗倍率；单人恒为 `1.0`（快照，参数页为准）。扩展只提交力量和角色倍率，瞬断、碾压、鱼体力扣减及猫体力消耗由本章统一计算。')
+emit(MAIN,'resources','9.2',[3],lambda t,i:'当前力量 ＝ 猫种基础力量 × 成长加成'+between(t,'**当前力量 ＝ 猫种基础力量 × 成长加成**','；主钓手归零')+'。操作不改力量（操作是运动学输入）。')
+head(MAIN,3,'4.2 强度检查与碾压','strength','鱼竿先承受拉力，再决定能否把鱼甩上岸。')
+emit(MAIN,'strength','4.2',[2],lambda t,i:'竿耐久与竿强度不能混称。'+between(t,'①','；②'))
