+# 写入前三件后检查引用和结构；迁移表在最后落盘。
+for file,parts in docs.items():
+    (ROOT/file).write_text('\n\n'.join(p for p in parts if p)+'\n',encoding='utf-8')
+
+map_parts=['# 迁移对照表\n\n唯一内容来源：[钓鱼规则整合稿](材料/钓鱼规则-整合稿.md)。执行蓝图：[讨论意见](讨论意见.md)。只搬规则、拆分职责、清理过程标记、统一字段别名与引用；引导句及接口归集不补拍玩法。源文件保持不变。\n\n来源 SHA-256：`'+hashlib.sha256(SRC.read_bytes()).hexdigest()+'`。段号 B 从零开始，按旧节内空行分段（表格与连续列表为一段）；每段逐一映射，混合段按句给多个去向。每条警示及组内成员另列独立行。历史／外册引文不构成新规范正文。', '<a id="section-map"></a>\n\n## 1. 旧节完整对照\n\n| 旧节 | 新落点 |\n|---|---|']
+for sec,d in sections.items():
+    targets=[]
+    for i in range(len(d['blocks'])):
+        for f,a,note in routes[(sec,i)]:
+            t=link(f,a,('外册待迁' if a.startswith('external') else '历史归档' if a=='archive' else f.replace('.md',''))+' · '+a)
+            if t not in targets: targets.append(t)
+    map_parts.append(f'| §{sec} {d["title"]} | '+'；'.join(targets)+' |')
+map_parts.append('<a id="block-map"></a>\n\n## 2. 原段逐项对照\n\n| 来源项 | 原段识别／行号 | 新落点与处理 |\n|---|---|---|')
+for sec,d in sections.items():
+    for i,text in enumerate(d['blocks']):
+        line=source[:source.index(text)].count('\n')+1
+        snippet=text.replace('\n',' / ').replace('|','／').replace('**','').replace('`','')[:52]
+        targets='；'.join(link(f,a,note) for f,a,note in routes[(sec,i)])
+        map_parts.append(f'| §{sec} B{i:02} | L{line} · {snippet}… | {targets} |')
+        if text.startswith('|'):
+            for j,row in enumerate(text.splitlines()[2:],1):
+                label=row.replace('|','／').replace('**','').replace('`','')[:75]
+                map_parts.append(f'| §{sec} B{i:02} T{j:02} | 表格成员：{label} | {targets} |')
+        elif text.startswith('- '):
+            for j,row in enumerate(text.splitlines(),1):
+                label=row.replace('|','／').replace('**','').replace('`','')[:75]
+                map_parts.append(f'| §{sec} B{i:02} I{j:02} | 列表成员：{label} | {targets} |')
+map_parts.append('<a id="gap-map"></a>\n\n## 3. 警示逐条对照\n\n页首四个 ⚠️ 为状态说明与标记字典，归历史归档；正文共 '+str(len(gaps))+' 处标记全部保留，包括组标题与表格意图标记。\n\n| 原标记 | 新落点 | 验收关联 |\n|---|---|---|')
+for n,(sec,i,raw) in enumerate(gaps,1):
+    category='生命周期／外部修改隔离' if sec.startswith('6.') else '战斗边界／收鱼与图鉴' if sec.startswith(('4.','5.','9.')) else '独立阅读／迁移完整'
+    map_parts.append(f'| §{sec} B{i:02} · ⚠️ {n:02} | [原文与责任人](钓鱼规则-主文.md#gap-{n:02}) | {category} |')
+    if '\n\n- ' in raw:
+        for j,row in enumerate(raw.split('\n\n',1)[1].splitlines(),1):
+            label=row.replace('|','／').replace('**','').replace('`','')[:70]
+            map_parts.append(f'| §{sec} ⚠️ {n:02} 子项 {j} · {label} | [同组原文](钓鱼规则-主文.md#gap-{n:02}) | {category} |')
+map_parts.append('## 4. 外册待迁原文\n\n下列段落已具体指定接收章节；接收册未修改。原文中已作废模型只供接收核对，须服从同段现行规则。')
+map_parts+=extparts
+map_parts.append('<a id="archive"></a>\n\n## 5. 历史归档与保留位置\n\n历史归档位置为本目录只读保留的[整合稿快照](材料/钓鱼规则-整合稿.md)，逐段行号见本表第二部分；[裁决记录](材料/2026-09-07裁决记录.md)仅作裁决核对。源文未删除、未覆盖。\n\n| 原项 | 归档原因与现行替代 |\n|---|---|\n| 页首状态、材料编号、四个标记释义 | 过程元数据；新文用本次交付状态与裁决索引 |\n| 各旧章标题与 48 个小节标题 | 目录元数据；映射至本表第一部分，不当玩法 |\n| §2.2、§2.5 连续近似／稳态验算；§2.8 数据流与验算 | 既有规则推导／重复总览，保留源快照；执行只认主文唯一公式 |\n| §4.3 21 行运动意图表及六项核对表 | 原文已定性不作执行查表；意图与核对过程留档。W／S、相近比值、前移修正及有效规则已内收；表内两个警示原样集中 |\n| §4.4 校准记录 | 不是正式配置；警示组与反例原样集中，不以旧数值公式重建第二套规则 |\n| §8.2 旧人数判定表与四处重叠复盘 | 原文明确不执行；现行力量合力模型在附篇 |\n| §8.4 动作表旧人数条件 | 素材交内容层，执行条件只能取附篇合力档位 |\n| §9.1 房主旧稿复盘、§9.2 旧消耗替代说明 | 过程历史归档，现行权限与统一公式已落位 |\n| 各段残留“已裁”、旧稿对照、表已拉取等说明 | 裁决出处集中；混合段其余原字保留于源快照供核对 |')
+map_parts.append('## 6. 引导句核对\n\n共 '+str(len(guides))+' 句：主文 '+str(sum(f==MAIN for f,a,t in guides))+' 句，附篇 '+str(sum(f==MULTI for f,a,t in guides))+' 句。按机制群设置；不对纯字段表、数据流与术语表加导语。\n\n| 位置 | 引导句 |\n|---|---|\n'+'\n'.join(f'| {link(f,a,a)} | {t} |' for f,a,t in guides))
+(ROOT/MAP).write_text('\n'.join(map_parts)+'\n',encoding='utf-8')
+print(json.dumps({'sections':len(sections),'blocks':sum(len(d['blocks']) for d in sections.values()),'warnings':len(gaps),'guides':len(guides),'files':{f:(ROOT/f).stat().st_size for f in [MAIN,MULTI,PACK,MAP]}},ensure_ascii=False))

