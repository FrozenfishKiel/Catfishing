+from pathlib import Path
+import re, hashlib, json
+
+ROOT = Path(__file__).parent
+SRC = ROOT/'材料/钓鱼规则-整合稿.md'
+source = SRC.read_text(encoding='utf-8-sig')
+sections = {}
+for m in re.finditer(r'(?ms)^### (\d+\.\d+) ([^\n]+)\n(.*?)(?=^## |^### |\Z)', source):
+    body = m[3].strip()
+    blocks = re.split(r'\n\s*\n', body)
+    cursor=m.start(3); block_lines=[]
+    for block in blocks:
+        pos=source.index(block,cursor); block_lines.append(source[:pos].count('\n')+1); cursor=pos+len(block)
+    sections[m[1]] = {'title':m[2], 'blocks':blocks, 'line':source[:m.start()].count('\n')+1,'block_lines':block_lines}
+
+MAIN='钓鱼规则-主文.md'; MULTI='多人钓鱼-附篇.md'; PACK='62迁移包.md'; MAP='迁移对照表.md'
+docs={MAIN:[],MULTI:[],PACK:[]}
+routes={}; anchors={}; guides=[]; gaps=[]
+def add(file,text): docs[file].append(text.strip())
+def head(file,level,title,anchor,guide=None):
+    add(file,f'<a id="{anchor}"></a>\n\n'+('#'*level)+' '+title)
+    anchors[anchor]=file
+    if guide:
+        add(file,guide); guides.append((file,anchor,guide))
+def link(file,anchor,label): return f'[{label}]({file}#{anchor})'
+def route(sec,i,file,anchor,note='规则搬移；仅清理过程标记及更新引用'):
+    routes.setdefault((sec,i),[]).append((file,anchor,note))
+def b(sec,i): return sections[sec]['blocks'][i]
+def before(s,t): return s.split(t)[0]
+def between(s,a,z): return s.split(a,1)[1].split(z,1)[0]
+
+# 显式旧节引用统一改成稳定机制锚点；裸写 9.3 仍指源文档。
+ref={
+'2.1':('nest','窝点归属'),'2.3':('timer','独立计时'),'2.4':('draw','抽鱼与扣减'),
+'2.5':('decay','游走衰减'),'2.9':('gather','聚鱼时刻'),'2.10':('visibility','世界可见性'),
+'3.4':('bait','鱼饵与道具闸门'),'4.1':('strike','提竿响应'),'4.2':('resources','资源字段'),
+'4.3':('strength','强度检查'),'4.4':('cost','搏斗消耗'),'4.5':('feedback','信息反馈'),
+'4.6':('behavior','鱼行为'),'4.7':('abandon','主动放弃'),'5.1':('netcatch','可抄资格'),
+'5.2':('mouth','挥网与叼鱼态'),'5.3':('belly','翻肚拖岸'),'5.4':('order','服务器判序'),
+'5.5':('geometry','收鱼几何'),'7.1':('feedback','操作反馈'),'8.2':('move','合力移动'),
+'8.3':('move-cost','移动消耗与恢复'),'8.4':('move-feedback','移动反馈'),
+'9.1':('assist','辅助入退'),'9.2':('team-force','力量组成'),'9.4':('position','位置落水'),
+'9.5':('capture','捕获事件')}
+
+def clean(text,file):
+    # 原缺口逐字存放附录；正文只留下缺口前的规则。
+    if '⚠️' in text and not text.startswith('|'):
+        text=text.split('⚠️',1)[0].strip().rstrip('，；')
+        if text and not text.endswith(('。','：','|')): text+='。'
+    text=text.replace('**','')
+    text=re.sub(r'已裁（[^）]*09-07[^）]*）：?', '', text)
+    text=re.sub(r'（(?:2026-)?09-0[67][^）]*(?:裁决|拍|修订|改值|改|重拍)[^）]*）','',text)
+    text=re.sub(r'（09-07 N\d+）','',text)
+    text=text.replace('（N2 后演出与数据一致）','').replace('（09-07 N8）','')
+    text=text.replace('（09-07 N4：碾压瞬间恰是竿受力最大时刻，烂竿先断、装备门槛不被绕过）','')
+    text=text.replace('（09-07 N9）','')
+    text=text.replace('，09-07 N4','').replace('线长经济按 09-07 N7 落定：','线长经济：').replace('，08-27 账本口径','')
+    text=text.replace('瞬断规则已裁保留（见本节下文）','瞬断规则见[强度检查](#strength)')
+    text=text.replace('；暂行口径转正','').replace('（决策点 3 顺带解决）','')
+    text=text.replace('（统一交互半径＋万能交互键，零新规则）','（统一交互半径＋万能交互键）')
+    # 仅替换有明确引用语境的节号，避免误改参数 1.5 等。
+    for old,(a,label) in ref.items():
+        target= MULTI if a in ('move','move-cost','move-feedback','assist','team-force') else MAIN
+        if file==MAIN and target==MULTI: continue
+        dest=f'#{a}' if target==file else f'{target}#{a}'
+        text=re.sub(r'(?<=见 )'+re.escape(old)+r'(?!\d)',f'[{label}]({dest})',text)
+        text=re.sub(r'(?<=按 )'+re.escape(old)+r'(?!\d)',f'[{label}]({dest})',text)
+        text=re.sub(r'(?<=复用 )'+re.escape(old)+r'(?!\d)',f'[{label}]({dest})',text)
+        text=re.sub(r'(?<=（)'+re.escape(old)+r'(?!\d)',f'[{label}]({dest})',text)
+        for prefix in ['走 ','进 ','进入 ','另验 ','使用 ','与 ','顺 ','照 ','，']:
+            text=re.sub(re.escape(prefix)+re.escape(old)+r'(?!\d)',prefix+f'[{label}]({dest})',text)
+    text=text.replace('2.4 的“扣成负数”','[抽扣](#draw)的“扣成负数”')
+    text=text.replace('5.1／5.5','[可抄资格](#netcatch)／[几何边界](#geometry)')
+    text=text.replace('第4章的资源落水意图','[资源落水](#position)').replace('第 5 章判序惯例','[服务器判序](#order)')
+    # 所有含数值的规则段、表格行补统一快照标记；不改变原数值。
+    lines=[]
+    in_code=False
+    for line in text.splitlines():
+        if line.startswith('```'): in_code=not in_code
+        visible=re.sub(r'\]\([^)]*\)',']',line)
+        if re.search(r'\d',visible) and '（快照，参数页为准）' not in line and not line.startswith('```') and not in_code:
+            if line.startswith('|') and line.endswith('|'):
+                line=line[:-1].rstrip()+'（快照，参数页为准） |'
+            else: line+='（快照，参数页为准）'
+        lines.append(line)
+    return '\n'.join(lines).strip()
+
+def emit(file,anchor,sec,inds,transform=None):
+    for i in inds:
+        text=b(sec,i)
+        if transform: text=transform(text,i)
+        add(file,clean(text,file))
+        route(sec,i,file,anchor,'按句拆分、统一字段／引用；原段全文保留在来源快照' if transform else '规则搬移；清理标记、更新引用、补快照标注')
+
+# 每个正文警示独立编号；组标题连带原列表保留，列表成员另列映射。
+for sec,d in sections.items():
+    for i,text in enumerate(d['blocks']):
+        if '⚠️' not in text: continue
+        if text.startswith('⚠️') and text.endswith('：') and i+1<len(d['blocks']):
+            raw=text+'\n\n'+d['blocks'][i+1]
+        elif text.startswith('|'):
+            for row in text.splitlines():
+                if '⚠️' in row:
+                    gaps.append((sec,i,row))
+            continue
+        else:
+            raw=text
+        gaps.append((sec,i,raw))
+gap_ids={}
+for n,(sec,i,raw) in enumerate(gaps,1): gap_ids.setdefault((sec,i),[]).append(f'gap-{n:02}')
+
