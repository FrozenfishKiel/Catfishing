import math,json
r={}
def T(x):return (15 if x>0 else 120)/(1+x/100)
r['bite']={str(x):T(x) for x in [0,1,0.9,6,11.4,99,100,200]}
r['jump_ratio']=T(0)/T(1)
r['remaining_100_to_200']=3*T(200)/T(100)
r['half_life_seconds']=30*math.log(.5)/math.log(.9)
r['decay_12_4']=12.4*.9
r['stock_example']={'decay':[v*.9 for v in [5,1,0]],'refill':[4.5,3.9,3],'after_x_fish':[3.5,3.9,3]}
r['probability_20_50_30']=[x/100 for x in [20,50,30]]
r['after_x_catch']=[19/99,50/99,30/99]
r['convergence_add_before_decay']=.9/(1-.9)
r['aggregation']={'min_total':3*30,'min_average_per_bag':3*30/5,'qualify':[min([45,52,38])>=30,min([45,52,12])>=30],'known_recipes_all_choices':[]}
for a in range(6):
 b=5-a;r['aggregation']['known_recipes_all_choices'].append({'giant':a,'worm':b,'pool':[16*a+10*b,2*a+2*b,a+b]})
r['recipe_probs']={'giant':[16/19,2/19,1/19],'worm':[10/13,2/13,1/13]}
r['trigger_example']={'10_trials_at_8pct':1-.92**10,'mean_trials':1/.08,'45_seconds_2_5x_at_total_100_rate_equivalent':45/(T(100)/2.5),'cooldown_end_to_end_seconds':45+240}
r['battle_speed']={str(v):v*(1+v/10)*10 for v in [0,5,10,20,30]}
r['giant_transcribed']={'multiplier':4*3*1*10,'at_delta1_seconds':100/(4*3*10),'at_delta30_seconds':100/(30*4*3*10)}
r['movement']={'forward':3*.5,'equal_forward':3*.5*1.5,'equal_backward':3*1.5,'wrong_minus_formula_forward':3-3*.5,'wrong_minus_equal_forward':3.6-3*.5*1.5,'minority_zero':100/8,'majority_zero':100/2,'difference_12_5_seconds':(8-2)*12.5,'idle_vs_work_10_seconds':5*10+2*10}
r['swap']={'shore_if_four_active':4-1-3,'recovery_5_to_50_at_double':(50-5)/(5*2),'time_left_at_fish75_with_5stamina':5/(75*.12),'time_left_at_fish200_with_5stamina':5/(200*.12)}
r['scoop']={str(x):x<1 for x in [.999,1,1.001]}
r['wear']={'fish75':75*.05,'cat50_fish_stamina_loss':50*.08,'fish75_cat_stamina_loss':75*.12,'fish200_cat_stamina_loss':200*.12}
r['offering']={'giant_to_small':10/1,'two_medium_one_small':2*2+1,'task40_give39_vs0':[39<40,0<40],'partial_resource_loss_difference':39-0,'day_seconds':10*60,'inferred_session_minutes':[5*12,6*12]}
r['fish_behavior']={'half_loop_out':4.5*2.5,'half_loop_in':3.5*-3,'net':4.5*2.5-3.5*3,'shallow_full_out':[min(.95,p*1.8) for p in [.7,.5,.35]],'shallow_low_out':[min(.95,p*.6*1.8) for p in [.7,.5,.35]],'shallow_low_in':[1-min(.95,p*.6*1.8) for p in [.7,.5,.35]],'stone_probability_sum':.05+.25+.7,'stone_expected_damage':.25*8,'mid_shallow_jump':1.8/1.5-1,'giant_max_burst_force':200*1.5}
r['fishing_net_profit_bound']={'cost_relative':1.2,'expected_net_relative':1-1.2,'roi':(1-1.2)/1.2}
print(json.dumps(r,ensure_ascii=False,indent=2))
