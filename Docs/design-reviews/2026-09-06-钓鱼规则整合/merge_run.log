+
+## 第3章 独立验算与线索复核
+
+### 3.1 可复跑的计算代码
+
+以下 Python 标准库代码已执行。测试用输入均只用于验证材料算式，不是新参数；转述参数、建议快照和缺正式数据的模型均在结果解释中区分。没有调用材料外的旧模拟器，也没有把历史模拟成功率当成新方案的验证。
+
+```python
+import math
+import json
+
+def T(total):
+    return (15 if total > 0 else 120) / (1 + total / 100)
+
+def move_rows(directions):
+    counts = [directions.count(d) for d in set(directions)]
+    two_split = sorted(counts) == [1, 1, 2]
+    no_three = max(counts) < 3
+    opposite_two_two = sorted(counts) == [2, 2] and set(directions) == {'W', 'S'}
+    return [name for name, hit in [
+        ('两同向其余分散龟速', two_split),
+        ('无三人同向打转', no_three),
+        ('2v2相反拔河', opposite_two_two),
+    ] if hit]
+
+out = {}
+out['间隔'] = {str(n): T(n) for n in [0, 1, 6, 11.4, 99, 100, 200]}
+out['切档倍数'] = T(0) / T(1)
+out['计时折算'] = 3 * T(200) / T(100)
+out['存量类别概率'] = [20/100, 50/100, 30/100]
+out['钓走腥鱼后概率'] = [19/99, 50/99, 30/99]
+out['衰减'] = {
+    '整数示例': [n * .9 for n in [20, 50, 30]],
+    '小数示例': 12.4 * .9,
+    '不足一条直接扣减': .6 - 1,
+    '半衰插值秒': 30 * math.log(.5) / math.log(.9),
+    '先补后衰稳态系数': .9 / (1 - .9),
+    '先衰后补稳态系数': 1 / (1 - .9),
+}
+out['流程示例'] = {
+    'A衰减后': [5 * .9, 1 * .9, 0],
+    '再补B': [4.5, .9 + 3, 0 + 3],
+    '再钓走腥鱼': [4.5 - 1, 3.9, 3],
+}
+out['聚鱼门槛'] = {
+    '最低总量': 3 * 30,
+    '五份最低平均': 3 * 30 / 5,
+    '原正例': min(45, 52, 38) >= 30,
+    '原反例': min(45, 52, 12) >= 30,
+    '已知两配方五份全部组合': [
+        [16*g + 10*(5-g), 2*g + 2*(5-g), g + (5-g)]
+        for g in range(6)
+    ],
+}
+out['两配方概率'] = {
+    '巨鱼窝': [16/19, 2/19, 1/19],
+    '虫虫窝': [10/13, 2/13, 1/13],
+}
+out['聚鱼概率及时间'] = {
+    '固定8pct十次至少一次': 1 - .92**10,
+    '几何期望判定次数': 1/.08,
+    '从结束冷却时最短起点间距秒': 45 + 240,
+    '从触发冷却时最短起点间距秒': max(45, 240),
+    '速度2_5倍时Total100间隔': T(100)/2.5,
+}
+out['完美削减测试'] = {
+    '普通': [100 * .8, 100 * .85],
+    '稀有': [100 * .85, 100 * .9],
+}
+out['搏斗原式数值测试'] = {
+    str(v): v * (1 + v/10) * 1 * 1 * 10
+    for v in [0, 5, 10, 20, 30]
+}
+out['巨影转述因子测试'] = {
+    '乘积': 4*3*1*10,
+    '位移1时耗尽秒': 100/(1*4*3*1*10),
+    '位移30时耗尽秒': 100/(30*4*3*1*10),
+}
+out['移动消耗测试'] = {
+    '强猫前移': 3*.5,
+    '相近前移按相乘': 3*.5*1.5,
+    '相近按独立档': 3*1.5,
+    '少数派耗尽秒': 100/8,
